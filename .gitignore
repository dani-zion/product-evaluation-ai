# See https://git-scm.com/docs/gitignore

# ─── Secrets & credentials (never commit) ───────────────────────────────
# Env files hold SUPABASE_SERVICE_ROLE_KEY and other secrets.
# Only the template without real values is committed.
.env
.env.*
*.env
!.env.example

# Private keys, certificates and credential files
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore
id_rsa*
id_ed25519*
credentials.json
service-account*.json
*.secret
secrets/

# Supabase CLI local state (may contain project refs, tokens, local DB data)
supabase/.branches/
supabase/.temp/
supabase/.env
supabase/**/.env*

# Vercel project link and pulled env vars
.vercel

# Claude Code local (per-user) settings
.claude/settings.local.json
.claude/worktrees/

# ─── Dependencies ───────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Build output & caches ──────────────────────────────────────────────
/.next/
/out/
/build
/dist
.turbo
.cache
*.tsbuildinfo
next-env.d.ts

# ─── Testing ────────────────────────────────────────────────────────────
/coverage
/test-results/
/playwright-report/

# ─── Logs ───────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
bun-debug.log*

# ─── OS files ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editors ────────────────────────────────────────────────────────────
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
