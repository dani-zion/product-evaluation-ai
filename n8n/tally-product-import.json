      "position": [448, 0],
      "id": "ff30fbed-7626-49db-aae9-bcc7c89ee3de",
      "name": "HTML"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.all()[0].json;\nconst BASE = \"https://www.amazon.com.br\";\n\n// Amazon's links are relative (\"/dp/…\"); make them absolute.\nconst absolute = (href) =>\n  !href ? \"\" : href.startsWith(\"http\") ? href : BASE + (href.startsWith(\"/\") ? \"\" : \"/\") + href;\n\nreturn data.name.map((name, i) => ({\n  json: {\n    name,\n    link: absolute(data.url[i]),\n    image: data.image[i],\n  },\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [672, 0],
      "id": "088cc3ca-ce96-448e-b7cc-f4acbaf1e942",
      "name": "Code in JavaScript"
    },
    {
