# Copy to .env.local and fill in from Supabase: Project Settings > API.
# Server-only values: never prefix them with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret for external clients (e.g. n8n) that create products with
# POST /api/v1/products. Send it as `Authorization: Bearer <key>`.
# Generate one with: openssl rand -base64 32
PRODUCTS_API_KEY=

# Signs the session cookie. At least 32 characters. Generate one with:
#   openssl rand -base64 32
# Changing it signs everyone out.
SESSION_SECRET=

# Writes the AI summary on each product page (Mastra agent, OpenAI).
# Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Or use Google Gemini instead (free tier): set this key and
# PRODUCT_SUMMARY_MODEL=google/gemini-2.5-flash
# Create one at https://aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: the model, as a Mastra "provider/model" string.
# Defaults to openai/gpt-4o-mini.
PRODUCT_SUMMARY_MODEL=
